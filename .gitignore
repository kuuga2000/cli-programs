# --------------------
# 1. Output/Generated Files
# --------------------

# Ignore all output files generated by the scripts
# Replace 'output' or 'dist' with the actual folder your scripts use.
/output/
/dist/
*.log
*.tmp
*.bak

# Ignore the split audio files from the ffmpeg examples
# Adjust the extension if you use .wav, .mp4, etc.
segment_*.mp3
part*.mp3

# --------------------
# 2. Sensitive / Temporary Files
# --------------------

# Ignore configuration files that might contain secrets or local paths
# (e.g., if you temporarily store API keys or passwords here)
*.config
*.env
.env
secret.txt

# Windows-specific files
Thumbs.db
desktop.ini

# --------------------
# 3. Executable / Compiled Files (if your shell script compiles anything)
# --------------------

# Ignore any compiled binaries or objects (unlikely for simple scripts)
*.o
*.exe

# multimedia and others
.mp3
.wav
.aac
.flac

.txt
